{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Abakus",
  "version": "0.1.0",
  "identifier": "sk.abakus.app",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Abakus", "width": 1280, "height": 820, "minWidth": 1024, "minHeight": 680, "dragDropEnabled": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; font-src 'self' data:" }
  },
  "bundle": { "active": false, "resources": ["resources/pdfium/pdfium.dll"] }
}
